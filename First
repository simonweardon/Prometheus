<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Prometheus Solutions — We Bring the Fire</title>
<meta name="description" content="Prometheus embeds with your team, maps every bottleneck, then builds and deploys AI agents that eliminate the friction holding your people back.">
<meta name="theme-color" content="#0B130E">
<meta property="og:title" content="Prometheus Solutions — We Bring the Fire">
<meta property="og:description" content="AI implementation. We embed, we diagnose, we build, we automate.">
<meta property="og:image" content="assets/art/og-share.jpg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Inter:wght@300;400;500&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
/* ═══════════════════════════════════════════════════════════════════════
   PROMETHEUS — DESIGN SYSTEM
   Aerospace / defense editorial. Forest noir, electric lime, Baroque oil.
   ═══════════════════════════════════════════════════════════════════════ */

* { margin: 0; padding: 0; box-sizing: border-box; }

:root {
  /* ── Surfaces ────────────────────────────────────────────────── */
  --noir:        #0B130E;   /* page ground — deep forest noir       */
  --noir-deep:   #070C09;   /* wells, footer, overlay drawer        */
  --panel:       #121D16;   /* cards, nested containers             */
  --panel-hi:    #16241A;   /* panel hover                          */

  /* ── Accent ──────────────────────────────────────────────────── */
  --lime:        #D0FF00;   /* CTAs, active states, telemetry       */
  --lime-dim:    #C4FA00;
  --lime-soft:   rgba(208, 255, 0, 0.14);
  --lime-line:   rgba(208, 255, 0, 0.34);

  /* ── Type colour ─────────────────────────────────────────────── */
  --bone:        #F3F4ED;   /* titles, body                         */
  --moss:        #6E8273;   /* metadata, subtitles                  */
  --moss-lt:     #93A598;   /* body copy on dark panels             */

  /* ── Rules & grid ────────────────────────────────────────────── */
  --line:        rgba(243, 244, 237, 0.10);
  --line-strong: rgba(243, 244, 237, 0.20);

  /* ── Type stacks ─────────────────────────────────────────────── */
  --display: 'Fraunces', 'Times New Roman', Georgia, serif;
  --sans:    'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --mono:    'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;

  /* ── Rhythm ──────────────────────────────────────────────────── */
  --gut:     clamp(1.5rem, 5vw, 6rem);   /* page gutter             */
  --band:    clamp(5rem, 11vw, 10rem);   /* vertical section rhythm */
  --bracket: 18px;                       /* HUD corner arm length   */

  --ease:    cubic-bezier(0.22, 1, 0.36, 1);
}

html { scroll-behavior: smooth; }

body {
  background: var(--noir);
  color: var(--bone);
  font-family: var(--sans);
  font-weight: 300;
  font-size: 16px;
  line-height: 1.65;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

/* Canvas grain — what makes flat colour read as a painted surface.
   Falls back to procedural SVG noise until the linen texture lands. */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  z-index: 9999;
  pointer-events: none;
  opacity: 0.5;
  background-image:
    url("assets/art/canvas-texture.jpg"),
    url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.035'/%3E%3C/svg%3E");
  background-size: 420px, 512px;
  background-repeat: repeat, repeat;
  mix-blend-mode: overlay;
}

::selection { background: var(--lime); color: var(--noir); }

/* ═══ TYPOGRAPHY PRIMITIVES ═══════════════════════════════════════════ */

h1, h2, h3 {
  font-family: var(--display);
  font-weight: 300;
  font-variation-settings: 'opsz' 144, 'SOFT' 0, 'WONK' 1;
  letter-spacing: -0.02em;
  line-height: 1.02;
  color: var(--bone);
}

h1 { font-size: clamp(3rem, 8.5vw, 7.5rem); }
h2 { font-size: clamp(2.25rem, 5.2vw, 4.5rem); line-height: 1.05; }
h3 { font-size: clamp(1.35rem, 2vw, 1.75rem); line-height: 1.15; }

h1 em, h2 em, h3 em {
  font-style: italic;
  font-variation-settings: 'opsz' 144, 'WONK' 1;
  color: var(--lime);
}

p { font-weight: 300; }

/* Tracked-out uppercase telemetry label — the connective tissue of the
   whole system: section tags, step numbers, spec lines, quick links. */
.tele {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  font-family: var(--mono);
  font-size: 0.66rem;
  font-weight: 400;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--moss);
}

.tele::before {
  content: '';
  width: 5px; height: 5px;
  background: var(--lime);
  flex: none;
}

/* Section tag with index numeral */
.tag {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  font-family: var(--mono);
  font-size: 0.66rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--moss);
  margin-bottom: 1.75rem;
}

.tag i {
  font-style: normal;
  color: var(--lime);
  border: 1px solid var(--lime-line);
  padding: 0.15rem 0.45rem;
  font-size: 0.6rem;
}

/* ═══ HUD CORNER BRACKETS ═════════════════════════════════════════════
   A full 1px border masked down to four corner squares — one pseudo-
   element, four brackets. Where mask is unsupported the whole hairline
   border shows, which is a clean and deliberate degradation. */

.framed { position: relative; }

.framed::before {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 2;
  border: 1px solid var(--lime-line);
  -webkit-mask:
    linear-gradient(#000 0 0) top    left  / var(--bracket) var(--bracket) no-repeat,
    linear-gradient(#000 0 0) top    right / var(--bracket) var(--bracket) no-repeat,
    linear-gradient(#000 0 0) bottom left  / var(--bracket) var(--bracket) no-repeat,
    linear-gradient(#000 0 0) bottom right / var(--bracket) var(--bracket) no-repeat;
  mask:
    linear-gradient(#000 0 0) top    left  / var(--bracket) var(--bracket) no-repeat,
    linear-gradient(#000 0 0) top    right / var(--bracket) var(--bracket) no-repeat,
    linear-gradient(#000 0 0) bottom left  / var(--bracket) var(--bracket) no-repeat,
    linear-gradient(#000 0 0) bottom right / var(--bracket) var(--bracket) no-repeat;
  transition: border-color 0.45s var(--ease);
}

.framed:hover::before { border-color: var(--lime); }

/* ═══ BUTTONS ═════════════════════════════════════════════════════════ */

.btn-fire, .btn-outline {
  display: inline-flex;
  align-items: center;
  gap: 0.7rem;
  font-family: var(--mono);
  font-size: 0.68rem;
  font-weight: 500;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  text-decoration: none;
  padding: 1.05rem 2rem;
  transition: all 0.4s var(--ease);
  white-space: nowrap;
}

.btn-fire {
  color: var(--noir);
  background: var(--lime);
  border: 1px solid var(--lime);
}

.btn-fire::after { content: '→'; transition: transform 0.4s var(--ease); }
.btn-fire:hover { background: var(--lime-dim); }
.btn-fire:hover::after { transform: translateX(4px); }

.btn-outline {
  color: var(--bone);
  background: transparent;
  border: 1px solid var(--line-strong);
}

.btn-outline:hover { border-color: var(--lime); color: var(--lime); }

.cta-group { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 2.75rem; }

/* ═══ NAV — minimal chrome ════════════════════════════════════════════ */

nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
  padding: 1.5rem var(--gut);
  background: linear-gradient(to bottom, rgba(11,19,14,0.9) 0%, rgba(11,19,14,0) 100%);
  border-bottom: 1px solid transparent;
  transition: background 0.5s var(--ease), border-color 0.5s var(--ease);
}

nav.stuck {
  background: rgba(11,19,14,0.94);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom-color: var(--line);
}

.logo {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  flex: none;
  white-space: nowrap;
  font-family: var(--display);
  font-size: 1.15rem;
  font-weight: 400;
  letter-spacing: 0.02em;
  color: var(--bone);
  text-decoration: none;
}

.logo span { font-style: italic; color: var(--lime); }

.logo-mark {
  flex: none;
  width: 1.1em;
  height: 1.35em;
  color: var(--bone);
}

.nav-right { display: flex; align-items: center; gap: 0.75rem; }

.nav-status {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--mono);
  font-size: 0.6rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--moss);
  margin-right: 0.75rem;
}

.nav-status::before {
  content: '';
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--lime);
  animation: pulse 2.6s infinite;
}

@keyframes pulse {
  0%   { box-shadow: 0 0 0 0 rgba(208,255,0,0.45); }
  70%  { box-shadow: 0 0 0 7px rgba(208,255,0,0); }
  100% { box-shadow: 0 0 0 0 rgba(208,255,0,0); }
}

.nav-login, .nav-cta {
  font-family: var(--mono);
  font-size: 0.64rem;
  font-weight: 500;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  text-decoration: none;
  padding: 0.72rem 1.3rem;
  transition: all 0.35s var(--ease);
}

.nav-login {
  color: var(--bone);
  border: 1px solid var(--line-strong);
}

.nav-login:hover { border-color: var(--lime); color: var(--lime); }

.nav-cta {
  color: var(--noir);
  background: var(--lime);
  border: 1px solid var(--lime);
}

.nav-cta:hover { background: var(--lime-dim); }

/* Menu trigger */
.nav-menu-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.7rem;
  background: none;
  border: 1px solid var(--line-strong);
  color: var(--bone);
  font-family: var(--mono);
  font-size: 0.64rem;
  font-weight: 500;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  padding: 0.72rem 1.15rem;
  cursor: pointer;
  transition: all 0.35s var(--ease);
}

.nav-menu-btn:hover { border-color: var(--lime); color: var(--lime); }

.nav-menu-btn i {
  display: flex;
  flex-direction: column;
  gap: 3px;
  width: 14px;
}

.nav-menu-btn i b {
  display: block;
  height: 1px;
  background: currentColor;
  transition: transform 0.4s var(--ease), opacity 0.3s;
}

body.nav-open .nav-menu-btn i b:nth-child(1) { transform: translateY(4px) rotate(45deg); }
body.nav-open .nav-menu-btn i b:nth-child(2) { opacity: 0; }
body.nav-open .nav-menu-btn i b:nth-child(3) { transform: translateY(-4px) rotate(-45deg); }

/* ═══ FULL-SCREEN OVERLAY DRAWER ══════════════════════════════════════ */

.drawer {
  position: fixed;
  inset: 0;
  z-index: 999;
  background: var(--noir-deep);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 7.5rem var(--gut) 3rem;
  overflow-y: auto;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-1.5rem);
  transition: opacity 0.5s var(--ease), transform 0.6s var(--ease), visibility 0.5s;
}

.drawer.open { opacity: 1; visibility: visible; transform: none; }

.drawer-list { list-style: none; }

.drawer-list li {
  border-top: 1px solid var(--line);
  opacity: 0;
  transform: translateY(1rem);
  transition: opacity 0.6s var(--ease), transform 0.6s var(--ease);
}

.drawer-list li:last-child { border-bottom: 1px solid var(--line); }
.drawer.open .drawer-list li { opacity: 1; transform: none; }
.drawer.open .drawer-list li:nth-child(1) { transition-delay: 0.10s; }
.drawer.open .drawer-list li:nth-child(2) { transition-delay: 0.16s; }
.drawer.open .drawer-list li:nth-child(3) { transition-delay: 0.22s; }
.drawer.open .drawer-list li:nth-child(4) { transition-delay: 0.28s; }
.drawer.open .drawer-list li:nth-child(5) { transition-delay: 0.34s; }
.drawer.open .drawer-list li:nth-child(6) { transition-delay: 0.40s; }

.drawer-list a {
  display: flex;
  align-items: baseline;
  gap: 1.5rem;
  padding: clamp(0.6rem, 1.6vw, 1.15rem) 0;
  font-family: var(--display);
  font-size: clamp(2rem, 5.5vw, 4.25rem);
  font-weight: 300;
  line-height: 1;
  letter-spacing: -0.02em;
  color: var(--bone);
  text-decoration: none;
  transition: color 0.4s var(--ease), padding-left 0.5s var(--ease);
}

.drawer-list a:hover { color: var(--lime); padding-left: 1.25rem; }

.drawer-list a u {
  font-family: var(--mono);
  font-size: 0.62rem;
  letter-spacing: 0.2em;
  text-decoration: none;
  color: var(--moss);
  flex: none;
  width: 2.5rem;
}

.drawer-list a s {
  margin-left: auto;
  text-decoration: none;
  font-family: var(--sans);
  font-size: 1.5rem;
  color: var(--lime);
  opacity: 0;
  transform: translateX(-0.75rem);
  transition: all 0.4s var(--ease);
}

.drawer-list a:hover s { opacity: 1; transform: none; }

.drawer-foot {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem 2.5rem;
  align-items: center;
  justify-content: space-between;
  padding-top: 2rem;
  margin-top: 2rem;
  border-top: 1px solid var(--line);
}

.drawer-quick { display: flex; flex-wrap: wrap; gap: 1.75rem; }

.drawer-quick a {
  font-family: var(--mono);
  font-size: 0.66rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--moss);
  text-decoration: none;
  transition: color 0.35s var(--ease);
}

.drawer-quick a:hover { color: var(--lime); }

/* ═══ FULL-BLEED PAINTING BANDS ═══════════════════════════════════════
   Art is graded toward the forest palette so the paintings live inside
   the page rather than sitting on top of it. Every band renders a
   deliberate gradient on its own, so a missing image degrades cleanly. */

.band-art {
  position: absolute;
  inset: 0;
  z-index: -2;
  background-image: var(--art);
  background-size: cover;
  background-position: var(--art-pos, center);
  filter: saturate(0.45) contrast(1.1) brightness(0.78);
}

.band-scrim {
  position: absolute;
  inset: 0;
  z-index: -1;
  background:
    linear-gradient(to right, rgba(11,19,14,0.94) 0%, rgba(11,19,14,0.62) 48%, rgba(11,19,14,0.34) 100%),
    linear-gradient(to bottom, rgba(11,19,14,0.85) 0%, rgba(11,19,14,0.15) 35%, rgba(11,19,14,0.92) 100%),
    radial-gradient(ellipse at 70% 45%, rgba(208,255,0,0.05), transparent 60%);
}

.band-scrim.center {
  background:
    linear-gradient(to bottom, rgba(11,19,14,0.92) 0%, rgba(11,19,14,0.55) 45%, rgba(11,19,14,0.95) 100%),
    radial-gradient(ellipse at 50% 70%, rgba(208,255,0,0.06), transparent 65%);
}

/* ═══ HERO ════════════════════════════════════════════════════════════ */

.hero {
  position: relative;
  min-height: 100svh;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 9rem var(--gut) 3.5rem;
  overflow: hidden;
  isolation: isolate;
}

.hero .band-art {
  --art: url('assets/art/hero.jpg');
  --art-pos: 72% center;
}

/* Hairline grid — the technical understructure */
.hero-grid {
  position: absolute;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  opacity: 0.5;
  background-image: linear-gradient(to right, var(--line) 1px, transparent 1px);
  background-size: 25% 100%;
}

.hero-content { max-width: 62rem; position: relative; }

.hero-eyebrow {
  display: flex;
  align-items: center;
  gap: 1rem;
  font-family: var(--mono);
  font-size: 0.68rem;
  letter-spacing: 0.26em;
  text-transform: uppercase;
  color: var(--lime);
  margin-bottom: 2rem;
}

.hero-eyebrow::after {
  content: '';
  height: 1px;
  flex: 1;
  max-width: 7rem;
  background: var(--lime-line);
}

.hero h1 { margin-bottom: 2.25rem; }

.hero-sub {
  max-width: 40rem;
  font-size: clamp(1rem, 1.35vw, 1.2rem);
  line-height: 1.7;
  color: var(--moss-lt);
}

/* Floating HUD guarantee badge */
.hero-guarantee {
  position: absolute;
  top: clamp(6.5rem, 16vh, 11rem);
  right: var(--gut);
  z-index: 3;
  max-width: 19rem;
  padding: 1.25rem 1.4rem;
  background: rgba(18,29,22,0.72);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  font-family: var(--mono);
  font-size: 0.7rem;
  line-height: 1.7;
  color: var(--moss-lt);
}

.hero-guarantee strong { color: var(--lime); font-weight: 500; }

/* Telemetry readout strip along the hero base */
.hero-telemetry {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem 2.5rem;
  align-items: center;
  justify-content: space-between;
  margin-top: 4rem;
  padding-top: 1.5rem;
  border-top: 1px solid var(--line);
  font-family: var(--mono);
  font-size: 0.62rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--moss);
}

.hero-telemetry span { display: inline-flex; align-items: center; gap: 0.55rem; }
.hero-telemetry span b { color: var(--lime); font-weight: 400; }

.hero-scroll-cue {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  font-family: var(--mono);
  font-size: 0.62rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--moss);
}

.hero-scroll-cue::after {
  content: '↓';
  color: var(--lime);
  animation: bob 2.4s var(--ease) infinite;
}

@keyframes bob {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(4px); }
}

/* ═══ STATEMENT BAND ══════════════════════════════════════════════════ */

.statement {
  padding: var(--band) var(--gut);
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  max-width: 78rem;
  margin: 0 auto;
}

.statement p {
  font-family: var(--display);
  font-size: clamp(1.5rem, 3.1vw, 2.75rem);
  font-weight: 300;
  font-style: italic;
  line-height: 1.28;
  letter-spacing: -0.015em;
  color: var(--bone);
  text-indent: -0.4em;
}

/* ═══ STAT STRIP ══════════════════════════════════════════════════════ */

.stat-strip {
  display: grid;
  grid-template-columns: 1fr 1px 1fr;
  align-items: center;
  gap: clamp(2rem, 6vw, 6rem);
  padding: clamp(3.5rem, 7vw, 6rem) var(--gut);
  max-width: 78rem;
  margin: 0 auto;
  border-bottom: 1px solid var(--line);
}

.stat-divider { background: var(--line); align-self: stretch; }

.stat-number {
  font-family: var(--display);
  font-size: clamp(3rem, 7vw, 6rem);
  font-weight: 300;
  line-height: 0.95;
  letter-spacing: -0.03em;
  color: var(--lime);
  margin-bottom: 1rem;
}

.stat-label {
  font-family: var(--mono);
  font-size: 0.66rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--moss);
  line-height: 1.8;
  max-width: 20rem;
}

/* ═══ SECTION SCAFFOLD ════════════════════════════════════════════════ */

section { padding: var(--band) var(--gut); }

/* Asymmetric two-column head: title left, standfirst right */
.sec-head {
  display: grid;
  grid-template-columns: 1.05fr 0.95fr;
  gap: clamp(2rem, 6vw, 7rem);
  align-items: end;
  max-width: 88rem;
  margin: 0 auto clamp(3.5rem, 7vw, 6rem);
  padding-bottom: 2.5rem;
  border-bottom: 1px solid var(--line);
}

.sec-head > p {
  font-size: clamp(0.95rem, 1.15vw, 1.06rem);
  line-height: 1.85;
  color: var(--moss-lt);
}

/* ═══ HOW WE WORK ═════════════════════════════════════════════════════ */

/* One HUD frame around the whole trio. Per-card brackets would collide
   with the 1px grid dividers and read as clutter. */
.how-steps {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: var(--line);
  max-width: 88rem;
  margin: 0 auto;
}

.step {
  position: relative;
  background: var(--noir);
  padding: clamp(2rem, 3vw, 3rem);
  transition: background 0.5s var(--ease);
}

.step:hover { background: var(--panel); }

/* Painting vignette per phase. The gradient sits UNDER the painting, so
   an absent image leaves a deliberate unlit plate rather than a void. */
.step-art {
  position: relative;
  aspect-ratio: 3 / 4;
  margin-bottom: 2rem;
  background-color: var(--panel);
  background-image:
    var(--art),
    radial-gradient(ellipse at 50% 30%, rgba(208,255,0,0.06), transparent 62%),
    linear-gradient(160deg, #16241A 0%, #0C1410 100%);
  background-size: cover, cover, cover;
  background-position: center;
  filter: saturate(0.4) contrast(1.08) brightness(0.8);
  transition: filter 0.6s var(--ease);
}

.step:hover .step-art { filter: saturate(0.6) contrast(1.08) brightness(0.92); }

.step-art::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(11,19,14,0.15), rgba(11,19,14,0.8));
}

.step-icon {
  position: absolute;
  inset: 0;
  margin: auto;
  width: 56px;
  height: 56px;
  z-index: 1;
  opacity: 0.85;
}

.step-num {
  display: block;
  font-family: var(--mono);
  font-size: 0.64rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--lime);
  margin-bottom: 1.5rem;
}

.step-title {
  font-family: var(--display);
  font-size: clamp(1.35rem, 1.9vw, 1.7rem);
  font-weight: 300;
  line-height: 1.15;
  letter-spacing: -0.015em;
  margin-bottom: 1rem;
}

.step-body { font-size: 0.94rem; line-height: 1.8; color: var(--moss-lt); }

.step-watermark {
  position: absolute;
  top: clamp(1.5rem, 2.5vw, 2.25rem);
  right: clamp(1.5rem, 2.5vw, 2.25rem);
  z-index: 3;
  font-family: var(--display);
  font-size: 3.5rem;
  font-style: italic;
  line-height: 1;
  color: var(--bone);
  opacity: 0.14;
  pointer-events: none;
}

/* ═══ PAINTING BREAK ══════════════════════════════════════════════════ */

.painting-break {
  position: relative;
  min-height: 78svh;
  display: flex;
  align-items: center;
  padding: var(--band) var(--gut);
  overflow: hidden;
  isolation: isolate;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.painting-break .band-art { --art: url('assets/art/break-bottleneck.jpg'); }

.pb-content { max-width: 46rem; }
.pb-content h2 { margin-bottom: 2rem; }
.pb-content p { font-size: clamp(1rem, 1.2vw, 1.12rem); line-height: 1.85; color: var(--moss-lt); }

/* ═══ AI AGENTS ═══════════════════════════════════════════════════════ */

.agents-banner {
  position: relative;
  aspect-ratio: 21 / 7;
  min-height: 220px;
  max-width: 88rem;
  margin: 0 auto clamp(3rem, 5vw, 4.5rem);
  overflow: hidden;
  isolation: isolate;
}

.agents-banner { background: linear-gradient(160deg, #16241A 0%, #0C1410 100%); }
.agents-banner .band-art { --art: url('assets/art/agents-automata.jpg'); }

.agents-banner .band-scrim {
  background:
    linear-gradient(to bottom, rgba(11,19,14,0.55), rgba(11,19,14,0.9)),
    radial-gradient(ellipse at 50% 80%, rgba(208,255,0,0.07), transparent 60%);
}

.agents-banner-cap {
  position: absolute;
  bottom: 1.5rem;
  left: 1.75rem;
  font-family: var(--mono);
  font-size: 0.62rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--moss);
}

.agents-grid, .custom-software-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: clamp(1rem, 1.6vw, 1.5rem);
  max-width: 88rem;
  margin: 0 auto;
}

.agent-card, .software-card {
  background: var(--panel);
  padding: clamp(2rem, 3vw, 3rem);
  transition: background 0.5s var(--ease);
}

.agent-card:hover, .software-card:hover { background: var(--panel-hi); }

.agent-tag, .software-card-tag {
  display: block;
  font-family: var(--mono);
  font-size: 0.62rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--lime);
  margin-bottom: 1.5rem;
}

.agent-title, .software-card-title {
  font-family: var(--display);
  font-size: clamp(1.3rem, 1.9vw, 1.7rem);
  font-weight: 300;
  line-height: 1.15;
  letter-spacing: -0.015em;
  margin-bottom: 1rem;
}

.agent-body, .software-card-body {
  font-size: 0.94rem;
  line-height: 1.8;
  color: var(--moss-lt);
  margin-bottom: 1.75rem;
}

.agent-examples, .software-card-examples { list-style: none; }

.agent-examples li, .software-card-examples li {
  position: relative;
  font-family: var(--mono);
  font-size: 0.72rem;
  letter-spacing: 0.06em;
  color: var(--moss);
  padding: 0.6rem 0 0.6rem 1.4rem;
  border-top: 1px solid var(--line);
}

.agent-examples li::before, .software-card-examples li::before {
  content: '';
  position: absolute;
  left: 0;
  top: 1.05rem;
  width: 5px; height: 5px;
  background: var(--lime);
  opacity: 0.6;
}

/* ═══ MYTH / WHO WE ARE ═══════════════════════════════════════════════ */

.myth {
  position: relative;
  border-top: 1px solid var(--line);
  overflow: hidden;
}

.myth-bg-text {
  position: absolute;
  bottom: -2vw;
  left: 50%;
  transform: translateX(-50%);
  font-family: var(--display);
  font-style: italic;
  font-size: clamp(6rem, 19vw, 22rem);
  font-weight: 300;
  line-height: 0.8;
  letter-spacing: -0.04em;
  color: var(--bone);
  opacity: 0.035;
  white-space: nowrap;
  pointer-events: none;
}

.myth-grid {
  position: relative;
  display: grid;
  grid-template-columns: 0.85fr 1.15fr;
  gap: clamp(2rem, 6vw, 6rem);
  align-items: center;
  max-width: 88rem;
  margin: 0 auto;
}

.myth-portrait {
  position: relative;
  aspect-ratio: 3 / 4;
  background-color: var(--panel);
  background-image:
    url('assets/art/myth.jpg'),
    radial-gradient(ellipse at 60% 28%, rgba(208,255,0,0.07), transparent 62%),
    linear-gradient(160deg, #16241A 0%, #0C1410 100%);
  background-size: cover, cover, cover;
  background-position: center;
  filter: saturate(0.5) contrast(1.08) brightness(0.9);
}

.myth-portrait-cap {
  position: absolute;
  bottom: -2.25rem;
  left: 0;
  font-family: var(--mono);
  font-size: 0.6rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--moss);
}

.myth-text h2 { margin-bottom: 2.5rem; }

.myth-pull {
  font-family: var(--display);
  font-style: italic;
  font-size: clamp(1.15rem, 1.75vw, 1.6rem);
  font-weight: 300;
  line-height: 1.45;
  color: var(--bone);
  border-left: 1px solid var(--lime);
  padding-left: 1.75rem;
  margin-bottom: 2.5rem;
}

.myth-text p {
  font-size: clamp(0.95rem, 1.1vw, 1.04rem);
  line-height: 1.85;
  color: var(--moss-lt);
  margin-bottom: 1.25rem;
}

/* ═══ TOOLS ═══════════════════════════════════════════════════════════ */

.tools-head { max-width: 88rem; margin: 0 auto clamp(3rem, 6vw, 5rem); }
.tools-head h2 { margin-bottom: 1.75rem; }

.tools-intro {
  max-width: 42rem;
  font-size: clamp(0.95rem, 1.15vw, 1.06rem);
  line-height: 1.85;
  color: var(--moss-lt);
}

.tools-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: var(--line);
  max-width: 88rem;
  margin: 0 auto;
}

.tool-tile {
  display: flex;
  flex-direction: column;
  background: var(--noir);
  padding: clamp(1.75rem, 2.4vw, 2.5rem);
  transition: background 0.5s var(--ease);
}

.tool-tile:hover { background: var(--panel); }

.tool-category {
  font-family: var(--mono);
  font-size: 0.6rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--moss);
  margin-bottom: 1.25rem;
}

.tool-name {
  font-family: var(--display);
  font-size: clamp(1.25rem, 1.7vw, 1.55rem);
  font-weight: 300;
  letter-spacing: -0.015em;
  line-height: 1.15;
  margin-bottom: 1rem;
}

.tool-name-featured { color: var(--lime); font-style: italic; }

.tool-body {
  flex: 1;
  font-size: 0.9rem;
  line-height: 1.8;
  color: var(--moss-lt);
  margin-bottom: 1.75rem;
}

.tool-use {
  font-family: var(--mono);
  font-size: 0.64rem;
  letter-spacing: 0.12em;
  color: var(--moss);
  padding-top: 1.25rem;
  border-top: 1px solid var(--line);
}

/* ═══ PROCESS — sticky rail tracker ═══════════════════════════════════ */

.process-visual {
  position: relative;
  padding: var(--band) var(--gut);
  overflow: hidden;
  isolation: isolate;
  border-top: 1px solid var(--line);
}

.process-visual .band-art { --art: url('assets/art/forge-process.jpg'); }

.process-visual .band-scrim {
  background:
    linear-gradient(to right, rgba(11,19,14,0.96) 0%, rgba(11,19,14,0.8) 60%, rgba(11,19,14,0.9) 100%),
    linear-gradient(to bottom, rgba(11,19,14,0.9), rgba(11,19,14,0.6) 40%, rgba(11,19,14,0.95));
}

.pv-inner {
  display: grid;
  grid-template-columns: 16rem 1fr;
  gap: clamp(2rem, 6vw, 7rem);
  max-width: 88rem;
  margin: 0 auto;
}

.pv-rail { position: sticky; top: 8rem; align-self: start; }

.pv-rail-tag { margin-bottom: 2rem; }

.pv-rail-list { list-style: none; }

.pv-rail-list li {
  display: flex;
  align-items: baseline;
  gap: 1rem;
  padding: 0.9rem 0;
  border-top: 1px solid var(--line);
  font-family: var(--mono);
  font-size: 0.68rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--moss);
  transition: color 0.45s var(--ease);
}

.pv-rail-list li:last-child { border-bottom: 1px solid var(--line); }
.pv-rail-list li.active { color: var(--lime); }

.pv-rail-list li em {
  flex: none;
  width: 1.75rem;
  font-style: normal;
  opacity: 0.6;
}

.pv-rail-list li.active em { opacity: 1; }

.pv-steps { display: flex; flex-direction: column; gap: clamp(3rem, 7vw, 6rem); }

.pv-step { max-width: 40rem; }

.pv-num {
  font-family: var(--mono);
  font-size: 0.64rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--lime);
  margin-bottom: 1.25rem;
}

.pv-title {
  font-family: var(--display);
  font-size: clamp(1.75rem, 3.2vw, 2.75rem);
  font-weight: 300;
  line-height: 1.1;
  letter-spacing: -0.02em;
  margin-bottom: 1rem;
}

.pv-body { font-size: clamp(0.95rem, 1.15vw, 1.06rem); line-height: 1.85; color: var(--moss-lt); }

/* ═══ INDUSTRIES ══════════════════════════════════════════════════════ */

.industries-head { max-width: 88rem; margin: 0 auto clamp(3rem, 5vw, 4.5rem); }

.industry-list { max-width: 88rem; margin: 0 auto; }

.industry-item {
  display: grid;
  grid-template-columns: 1fr auto 3rem;
  align-items: center;
  gap: 2rem;
  padding: clamp(1.4rem, 2.4vw, 2.1rem) 0;
  border-top: 1px solid var(--line);
  transition: padding-left 0.5s var(--ease);
}

.industry-item:last-child { border-bottom: 1px solid var(--line); }
.industry-item:hover { padding-left: 1.5rem; }

.industry-name {
  font-family: var(--display);
  font-size: clamp(1.35rem, 2.6vw, 2.25rem);
  font-weight: 300;
  letter-spacing: -0.02em;
  line-height: 1.1;
  transition: color 0.4s var(--ease);
}

.industry-item:hover .industry-name { color: var(--lime); }

.industry-tag {
  font-family: var(--mono);
  font-size: 0.64rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--moss);
  text-align: right;
}

.industry-arrow {
  font-size: 1.25rem;
  color: var(--lime);
  text-align: right;
  opacity: 0;
  transform: translateX(-0.75rem);
  transition: all 0.45s var(--ease);
}

.industry-item:hover .industry-arrow { opacity: 1; transform: none; }

/* ═══ CUSTOM SOFTWARE ═════════════════════════════════════════════════ */

.custom-software { border-top: 1px solid var(--line); }
.custom-software-grid { grid-template-columns: repeat(3, 1fr); }

.custom-software-cta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  max-width: 88rem;
  margin: clamp(3rem, 5vw, 4.5rem) auto 0;
  padding-top: 2.5rem;
  border-top: 1px solid var(--line);
}

.custom-software-cta p {
  font-family: var(--display);
  font-style: italic;
  font-size: clamp(1.15rem, 1.7vw, 1.5rem);
  font-weight: 300;
  color: var(--bone);
}

/* ═══ CTA ═════════════════════════════════════════════════════════════ */

.cta-section {
  position: relative;
  min-height: 85svh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: var(--band) var(--gut);
  overflow: hidden;
  isolation: isolate;
  border-top: 1px solid var(--line);
}

.cta-section .band-art { --art: url('assets/art/cta-gift.jpg'); }

.cta-content { max-width: 48rem; }
.cta-content .tag { justify-content: center; }
.cta-content h2 { margin-bottom: 2rem; }

.cta-content > p {
  font-size: clamp(1rem, 1.25vw, 1.15rem);
  line-height: 1.85;
  color: var(--moss-lt);
}

.cta-email { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--line); }

.cta-email a {
  font-family: var(--mono);
  font-size: 0.72rem;
  letter-spacing: 0.16em;
  color: var(--moss);
  text-decoration: none;
  transition: color 0.35s var(--ease);
}

.cta-email a:hover { color: var(--lime); }

/* ═══ FOOTER ══════════════════════════════════════════════════════════ */

footer { background: var(--noir-deep); padding: clamp(4rem, 7vw, 6rem) var(--gut) 2.5rem; }

.footer-top {
  display: grid;
  grid-template-columns: 1.6fr repeat(3, 1fr);
  gap: clamp(2rem, 4vw, 4rem);
  max-width: 88rem;
  margin: 0 auto;
  padding-bottom: clamp(3rem, 5vw, 4rem);
  border-bottom: 1px solid var(--line);
}

.footer-brand .logo { margin-bottom: 1.5rem; }

.footer-brand p {
  font-size: 0.9rem;
  line-height: 1.85;
  color: var(--moss);
  max-width: 24rem;
}

.footer-col-head {
  font-family: var(--mono);
  font-size: 0.62rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--lime);
  margin-bottom: 1.5rem;
}

.footer-links { list-style: none; }
.footer-links li { margin-bottom: 0.85rem; }

.footer-links a {
  font-size: 0.88rem;
  color: var(--moss);
  text-decoration: none;
  transition: color 0.35s var(--ease);
}

.footer-links a:hover { color: var(--bone); }

.footer-bottom {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem 2rem;
  align-items: center;
  justify-content: space-between;
  max-width: 88rem;
  margin: 0 auto;
  padding-top: 2.5rem;
  font-family: var(--mono);
  font-size: 0.62rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--moss);
}

.footer-myth { color: var(--lime); opacity: 0.75; }

/* ═══ SCROLL REVEAL ═══════════════════════════════════════════════════ */

.reveal {
  opacity: 0;
  transform: translateY(1.5rem);
  transition: opacity 0.9s var(--ease), transform 0.9s var(--ease);
}

.reveal.revealed { opacity: 1; transform: none; }
.reveal.d1 { transition-delay: 0.08s; }
.reveal.d2 { transition-delay: 0.16s; }
.reveal.d3 { transition-delay: 0.24s; }

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .reveal { opacity: 1; transform: none; transition: none; }
  *, *::before, *::after {
    animation-duration: 0.001s !important;
    transition-duration: 0.001s !important;
  }
}

/* ═══ RESPONSIVE ══════════════════════════════════════════════════════ */

@media (max-width: 1100px) {
  .how-steps, .tools-grid, .custom-software-grid { grid-template-columns: repeat(2, 1fr); }
  .pv-inner { grid-template-columns: 1fr; }
  .pv-rail { position: static; }
  .footer-top { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 900px) {
  .sec-head, .myth-grid { grid-template-columns: 1fr; align-items: start; }
  .myth-portrait { max-width: 22rem; }
  .myth-portrait-cap { position: static; display: block; margin-top: 1rem; }
  .nav-status, .nav-login { display: none; }
  .hero { justify-content: center; }
  .hero-guarantee { position: static; max-width: none; margin-bottom: 2.5rem; }
}

@media (max-width: 760px) {
  :root { --bracket: 12px; }
  .hero .band-art {
    --art: url('assets/art/hero-mobile.jpg');
    --art-pos: center 30%;
  }
  .hero .band-scrim {
    background: linear-gradient(to bottom, rgba(11,19,14,0.8) 0%, rgba(11,19,14,0.45) 35%, rgba(11,19,14,0.97) 88%);
  }
  .agents-grid, .how-steps, .tools-grid, .custom-software-grid { grid-template-columns: 1fr; }
  .agents-banner { aspect-ratio: 16 / 9; }
  .stat-strip { grid-template-columns: 1fr; gap: 2.5rem; }
  .stat-divider { height: 1px; align-self: auto; }
  .industry-item { grid-template-columns: 1fr auto; gap: 0.5rem 1rem; }
  .industry-tag { grid-column: 1 / -1; text-align: left; }
  .industry-arrow { display: none; }
  .footer-top { grid-template-columns: 1fr; }
  .statement p { text-indent: 0; }
  .nav-cta { display: none; }
}
</style>
